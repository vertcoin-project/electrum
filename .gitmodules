[submodule "electrum_vtc/locale"]
	path = electrum_vtc/locale
    url = https://github.com/spesmilo/electrum-locale
    ignore = dirty
[submodule "electrum_vtc/plugins/keepkey/keepkeylib"]
	path = electrum_vtc/plugins/keepkey/keepkeylib
    url = https://github.com/spesmilo/electrum-keepkeylib.git
[submodule "contrib/vertcoinhash"]
	path = contrib/vertcoinhash
	url = https://github.com/vertcoin-project/vertcoinhash-python.git
